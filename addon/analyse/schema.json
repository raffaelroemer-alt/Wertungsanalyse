{
  "type": "object",
  "additionalProperties": false,
  "required": ["textlage", "gattung", "kennzeichnungsproblem", "markierungen", "teilwerte", "richtung", "strategische_muster", "stimmen", "beitraege", "kennzahl", "neutrale_fassung", "hinweise"],
  "properties": {
    "textlage": {
      "type": "string",
      "enum": ["vollstaendig", "unvollstaendig", "nur_zusammenfassung", "kein_artikel"]
    },
    "gattung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["art", "begruendung"],
      "properties": {
        "art": {
          "type": "string",
          "enum": ["Agenturmeldung", "Bericht", "Analyse/Erklärstück", "Reportage", "Interview", "Kommentar/Meinung", "Glosse", "Chronik/Liste", "Lagebericht", "Pressemitteilung", "Behördenkommunikation", "sonstige"]
        },
        "begruendung": {"type": "string"}
      }
    },
    "kennzeichnungsproblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vorhanden", "begruendung"],
      "properties": {
        "vorhanden": {"type": "boolean"},
        "begruendung": {"type": "string"}
      }
    },
    "markierungen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zitat", "dimension", "begruendung", "alternative", "wirkung", "wortleiter", "strittig", "ausserhalb_zaehlbasis", "nur_struktur"],
        "properties": {
          "zitat": {"type": "string", "description": "zeichengenau aus dem Artikel, höchstens zehn Wörter"},
          "dimension": {"type": "string", "enum": ["wortwahl", "epistemisch", "quellen", "auswahl", "ueberschrift"]},
          "begruendung": {"type": "string"},
          "alternative": {"type": "string"},
          "wirkung": {"type": "string", "description": "möglicher Eindruck beim Leser, als Einschätzung formuliert"},
          "wortleiter": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stufen", "gewaehlt", "neutral"],
            "properties": {
              "stufen": {"type": "array", "items": {"type": "string"}, "description": "3–7 Ausdrücke von abwertend zu aufwertend, sonst leer"},
              "gewaehlt": {"type": "integer", "description": "Stelle des Ausdrucks aus dem Artikel, ab 0"},
              "neutral": {"type": "integer", "description": "Stelle des neutralsten Ausdrucks, ab 0"}
            }
          },
          "strittig": {"type": "boolean"},
          "ausserhalb_zaehlbasis": {"type": "boolean"},
          "nur_struktur": {"type": "boolean"}
        }
      }
    },
    "teilwerte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wortwahl", "epistemisch", "quellen", "auswahl", "ueberschrift"],
      "properties": {
        "wortwahl": {"$ref": "#/$defs/teilwert"},
        "epistemisch": {"$ref": "#/$defs/teilwert"},
        "quellen": {"$ref": "#/$defs/teilwert"},
        "auswahl": {"$ref": "#/$defs/teilwert"},
        "ueberschrift": {"$ref": "#/$defs/teilwert"}
      }
    },
    "richtung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["einordnung", "zugunsten", "zulasten", "belege", "begruendung"],
      "properties": {
        "einordnung": {"type": "string", "enum": ["parteinahme", "zuspitzung_ohne_parteinahme", "keine_erkennbare_richtung"]},
        "zugunsten": {"type": "array", "items": {"type": "string"}},
        "zulasten": {"type": "array", "items": {"type": "string"}},
        "belege": {"type": "array", "items": {"type": "string"}},
        "begruendung": {"type": "string"}
      }
    },
    "strategische_muster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["muster", "leitbegriffe"],
      "properties": {
        "muster": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["art", "belege", "begruendung", "strittig"],
            "properties": {
              "art": {"type": "string", "enum": ["moralische_klammer", "moralische_delegitimierung", "dichotomie", "vereinnahmendes_wir", "umbenennung", "leitbegriff_wiederholung", "angstappell", "suendenbock"]},
              "belege": {"type": "array", "items": {"type": "string", "description": "zeichengenau aus dem Artikel, höchstens zehn Wörter"}},
              "begruendung": {"type": "string"},
              "strittig": {"type": "boolean"}
            }
          }
        },
        "leitbegriffe": {"type": "array", "items": {"type": "string", "description": "wertender Schlüsselbegriff in Grundform, höchstens drei Wörter"}}
      }
    },
    "stimmen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liste", "ohne_stimme"],
      "properties": {
        "liste": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sprecher", "typ", "anonym", "aussagen", "position", "erstes_vorkommen", "absaetze"],
            "properties": {
              "sprecher": {"type": "string"},
              "typ": {"type": "string", "enum": ["regierung_verwaltung", "partei_parlament", "justiz", "sicherheit", "wirtschaft", "verband", "zivilgesellschaft", "wissenschaft", "internationale_organisation", "medien", "betroffene", "sonstige"]},
              "anonym": {"type": "boolean"},
              "aussagen": {"type": "integer"},
              "position": {"type": "string", "description": "Haltung zur Streitfrage, gleicher Wortlaut für gleiche Haltung, sonst 'ohne Position'"},
              "erstes_vorkommen": {"type": "string", "description": "zeichengenau aus dem Artikel, höchstens zehn Wörter"},
              "absaetze": {"type": "array", "items": {"type": "integer"}, "description": "Nummern der Absätze [Absatz N] mit O-Ton dieser Stimme, sonst leer"}
            }
          }
        },
        "ohne_stimme": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["akteur", "rolle", "vermerk"],
            "properties": {
              "akteur": {"type": "string"},
              "rolle": {"type": "string"},
              "vermerk": {"type": "string", "enum": ["kein_vermerk", "angefragt_ohne_antwort", "aeusserung_abgelehnt"]}
            }
          }
        }
      }
    },
    "beitraege": {
      "type": "array",
      "description": "nur bei Transkripten einer ganzen Sendung, sonst leer",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["thema", "beginn", "art", "teilwerte", "kennzahl", "richtung", "kurz"],
        "properties": {
          "thema": {"type": "string"},
          "beginn": {"type": "string", "description": "zeichengenau aus dem Text, erste Wörter des Beitrags, höchstens zehn Wörter"},
          "art": {"type": "string", "enum": ["bericht", "interview", "schaltgespraech", "kommentar", "meldung", "sport", "wetter", "sonstiges"]},
          "teilwerte": {
            "type": "object",
            "additionalProperties": false,
            "required": ["wortwahl", "epistemisch", "quellen", "auswahl", "ueberschrift"],
            "properties": {
              "wortwahl": {"type": "integer", "enum": [0, 1, 2, 3, 4]},
              "epistemisch": {"type": "integer", "enum": [0, 1, 2, 3, 4]},
              "quellen": {"type": "integer", "enum": [0, 1, 2, 3, 4]},
              "auswahl": {"type": "integer", "enum": [0, 1, 2, 3, 4]},
              "ueberschrift": {"type": "integer", "enum": [0, 1, 2, 3, 4]}
            }
          },
          "kennzahl": {
            "type": "object",
            "additionalProperties": false,
            "required": ["markiert", "gesamt", "strittig"],
            "properties": {"markiert": {"type": "integer"}, "gesamt": {"type": "integer"}, "strittig": {"type": "integer"}}
          },
          "richtung": {
            "type": "object",
            "additionalProperties": false,
            "required": ["einordnung", "zugunsten", "zulasten"],
            "properties": {
              "einordnung": {"type": "string", "enum": ["parteinahme", "zuspitzung_ohne_parteinahme", "keine_erkennbare_richtung"]},
              "zugunsten": {"type": "array", "items": {"type": "string"}},
              "zulasten": {"type": "array", "items": {"type": "string"}}
            }
          },
          "kurz": {"type": "string"}
        }
      }
    },
    "kennzahl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markiert", "gesamt", "strittig"],
      "properties": {
        "markiert": {"type": "integer"},
        "gesamt": {"type": "integer"},
        "strittig": {"type": "integer"}
      }
    },
    "neutrale_fassung": {"type": "string"},
    "hinweise": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "teilwert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wert", "begruendung"],
      "properties": {
        "wert": {"type": "integer", "enum": [0, 1, 2, 3, 4]},
        "begruendung": {"type": "string"}
      }
    }
  }
}
